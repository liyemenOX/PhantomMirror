def load_known_devices():
    """Load registry of all previously connected devices."""
    try:
        if os.path.exists(REGISTRY_FILE):
            with open(REGISTRY_FILE, "r") as f:
                return json.load(f)
    except Exception:
        pass
    return {}

def save_known_device(serial, model, ip):
    """Save or update device entry in the persistent multi-device registry."""
    try:
        reg = load_known_devices()
        clean_ip = ip.split(":")[0].strip()
        reg[serial] = {
            "model": model,
            "ip": clean_ip,
            "last_seen": int(time.time()),
        }
        with open(REGISTRY_FILE, "w") as f:
            json.dump(reg, f, indent=2)
    except Exception:
        pass

def save_last_ip(ip):
    try:
        clean_ip = ip.split(":")[0].strip()
        with open(LAST_IP_FILE, "w") as f:
            f.write(clean_ip)
    except Exception:
        pass

def load_last_ip():
    try:
        if os.path.exists(LAST_IP_FILE):
            with open(LAST_IP_FILE, "r") as f:
                ip = f.read().strip()
                if ip:
                    return ip
    except Exception:
        pass
    return None

def get_default_gateway():
    """Find the Wi-Fi / Hotspot gateway IP address automatically."""
    try:
        out = subprocess.check_output(["ip", "route"], text=True)
        for line in out.splitlines():
            if line.startswith("default via"):
                parts = line.split()
                if len(parts) >= 3:
                    return parts[2]
    except Exception:
        pass
    return "192.168.43.1"

def probe_adb_port(ip, port=5555, timeout=0.25):
    """Quickly check if port is open before invoking heavy ADB handshake."""
    clean_ip = ip.split(":")[0].strip()
    if not clean_ip:
        return None
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect((clean_ip, port))
        s.close()
        return (clean_ip, port)
    except Exception:
        return None

def get_arp_ips():
    """Scan active IP neighbors from Linux kernel ARP cache."""
    ips = set()
    try:
        out = subprocess.check_output(["ip", "neigh"], text=True, timeout=1)
        for line in out.splitlines():
            parts = line.split()
            if len(parts) >= 1 and parts[0].count(".") == 3:
                ips.add(parts[0])
    except Exception:
        pass
    try:
        with open("/proc/net/arp", "r") as f:
            for line in f.readlines()[1:]:
                parts = line.split()
                if len(parts) >= 1 and parts[0].count(".") == 3:
                    ips.add(parts[0])
    except Exception:
        pass
    return list(ips)

def get_mdns_targets():
    """Discover devices advertising Wireless Debugging via Android mDNS."""
    targets = []
    try:
        out = subprocess.check_output(["adb", "mdns", "services"], text=True, timeout=2)
        for line in out.splitlines():
            m = re.search(r"(\d+\.\d+\.\d+\.\d+):(\d+)", line)
            if m:
                targets.append((m.group(1), int(m.group(2))))
    except Exception:
        pass
    return targets

def get_local_subnet_ips():
    """Generate all IPs on local /24 subnet for parallel sweep."""
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        local_ip = s.getsockname()[0]
        s.close()
        prefix = ".".join(local_ip.split(".")[:3])
        return [f"{prefix}.{i}" for i in range(1, 255)]
    except Exception:
        return []

def auto_discover_wireless_phones():
    """
    Multi-stage automatic wireless phone discovery:
    1. Known devices registry + ARP cache + Gateway (<0.2s)
    2. Android mDNS wireless debugging services (<0.3s)
    3. Fast parallel local subnet sweep (~1.0s)
    """
    found_targets = []

    # Priority 1: High-probability candidates (known IPs + ARP cache + Gateway + Hotspot)
    known = load_known_devices()
    known_ips = [dev["ip"] for dev in known.values() if isinstance(dev, dict) and dev.get("ip")]
    last_ip = load_last_ip()
    if last_ip and last_ip not in known_ips:
        known_ips.append(last_ip)

    arp_ips = get_arp_ips()
    gw = get_default_gateway()
    candidates = list(dict.fromkeys(known_ips + arp_ips + ([gw] if gw else []) + ["192.168.43.1"]))

    with ThreadPoolExecutor(max_workers=24) as ex:
        results = [res for res in ex.map(lambda ip: probe_adb_port(ip), candidates) if res]
    found_targets.extend(results)

    # Priority 2: Android mDNS ZeroConf
    if not found_targets:
        mdns_targets = get_mdns_targets()
        for ip, port in mdns_targets:
            res = probe_adb_port(ip, port)
            if res and res not in found_targets:
                found_targets.append(res)

    # Priority 3: Local subnet parallel sweep (covers any new phone connected to Wi-Fi)
    if not found_targets:
        print("[*] Probing local network for wireless Android phones...")
        subnet_ips = get_local_subnet_ips()
        if subnet_ips:
            with ThreadPoolExecutor(max_workers=64) as ex:
                results = [res for res in ex.map(lambda ip: probe_adb_port(ip), subnet_ips) if res]
            found_targets.extend(results)

    return found_targets

def try_connect_ip(ip, port=5555):
    """Attempt connecting to a specific IP on port 5555."""
    clean_ip = ip.split(":")[0].strip()
    if not clean_ip:
        return False
    target = f"{clean_ip}:{port}"
    print(f"[*] Trying wireless connection to {target}...")
    try:
        out = subprocess.check_output(["adb", "connect", target], text=True, timeout=5)
        if "connected to" in out.lower() or "already connected" in out.lower():
            print(f"[+] Successfully connected to {target}")
            save_last_ip(clean_ip)
            return True
    except Exception:
        pass
    return False

def get_connected_devices(wait_for_auth=True):
    try:
        out = subprocess.check_output(["adb", "devices", "-l"], text=True)
        lines = [line.strip() for line in out.strip().split("\n")[1:] if line.strip()]
        devices = []
        unauthorized = []
        offline = []

        for line in lines:
            parts = line.split()
            if len(parts) >= 2:
                serial = parts[0]
                state = parts[1]
                model = "Android Device"
                for p in parts[2:]:
                    if p.startswith("model:"):
                        model = p.split(":")[1]
                if state == "device":
                    devices.append((serial, model))
                elif state == "unauthorized":
                    unauthorized.append((serial, model))
                elif state == "offline":
                    offline.append((serial, model))

        # Automatically reconnect offline sockets
        if offline:
            subprocess.run(["adb", "reconnect"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        # Handle unauthorized new phones with clear guidance
        if unauthorized and not devices and wait_for_auth:
            print("\n" + "="*50)
            print("⚠️  AUTHORIZATION REQUIRED ON YOUR PHONE SCREEN")
            print("="*50)
            for ser, mod in unauthorized:
                print(f"[!] Device {mod} ({ser}) is waiting for permission.")
            print("[*] 1. Unlock your phone screen right now.")
            print("[*] 2. Look for popup: 'Allow USB debugging from this computer?'")
            print("[*] 3. Check: [✓] Always allow from this computer")
            print("[*] 4. Tap 'ALLOW'")
            print("[*] Waiting for authorization...")

            for _ in range(8):
                time.sleep(1.5)
                refreshed = get_connected_devices(wait_for_auth=False)
                if refreshed:
                    print("[+] Device authorized successfully!")
                    return refreshed

        return devices
    except Exception as e:
        print(f"[-] ADB query error: {e}")
        return []

def detect_hardware():
    """Detect GPU vendor (NVIDIA / Intel / AMD) to select optimal decoder."""
    try:
        lspci = subprocess.check_output(["lspci"], text=True).lower()
        if "nvidia" in lspci:
            return "nvidia"
        elif "intel" in lspci:
            return "intel"
        elif "amd" in lspci or "radeon" in lspci:
            return "amd"
    except Exception:
        pass
    return "integrated"

def get_phone_ip(serial=None):
    cmd = ["adb"]
    if serial:
        cmd.extend(["-s", serial])
    cmd.extend(["shell", "ip route | awk '{print $9}' | head -n 1"])
    try:
        ip = subprocess.check_output(cmd, text=True).strip()
        if ip and ip.count(".") == 3:
            return ip
    except Exception:
        pass
    return get_default_gateway()

def launch_mirror(profile="pro", wireless=False, custom_ip=None, screen_off=False, virtual_display=False, app=None, audio=True, frame=True, pure_shape=False, scale=None):
    # 1. If user supplied an explicit IP, connect to it directly
    if custom_ip:
        try_connect_ip(custom_ip)

    devices = get_connected_devices()

    # 2. If no devices connected, perform multi-stage zero-config wireless discovery
    if not devices:
        print("[*] Scanning network for wireless phones (Zero-Config Discovery)...")
        discovered_targets = auto_discover_wireless_phones()

        for ip, port in discovered_targets:
            try_connect_ip(ip, port)

        devices = get_connected_devices()

    # 3. If still no device, prompt the user for IP or USB fallback
    if not devices:
        print("\n[-] Could not auto-detect your phone's wireless IP.")
        print("[*] To connect wirelessly:")
        print("    1. Plug in USB once and run: ./phantom --wireless (to auto-configure)")
        print("    2. Or enter your phone's Wi-Fi IP address directly below.")
        print("       (Find it on your phone in Settings -> Wi-Fi -> IP Address)")
        try:
            manual_ip = input("\n[?] Enter phone IP (or press Enter to cancel): ").strip()
            if manual_ip:
                if try_connect_ip(manual_ip):
                    devices = get_connected_devices()
        except (KeyboardInterrupt, EOFError):
            print("\nAborted.")
            sys.exit(1)

    if not devices:
        print("\n[-] No device connected. Please plug in USB or connect to Wi-Fi/Hotspot.")
        sys.exit(1)

    # If multiple devices connected, offer interactive pick or auto-select default
    if len(devices) == 1:
        target_device = devices[0]
    else:
        print(f"\n[+] Found {len(devices)} connected Android devices:")
        for idx, (ser, mod) in enumerate(devices, 1):
            conn_type = "Wireless" if ":" in ser else "USB"
            print(f"    [{idx}] {mod} ({ser}) - {conn_type}")
        try:
            choice = input(f"[?] Select device [1-{len(devices)}] (Default: 1): ").strip()
            sel_idx = int(choice) - 1 if choice.isdigit() and 1 <= int(choice) <= len(devices) else 0
            target_device = devices[sel_idx]
        except (KeyboardInterrupt, EOFError):
            target_device = devices[0]

    # If wireless mode requested but connected via USB, enable TCP/IP and switch
    if wireless:
        wireless_devs = [d for d in devices if ":" in d[0]]
        if wireless_devs:
            target_device = wireless_devs[0]
        else:
            usb_serial = devices[0][0]
            print(f"[*] Enabling Wi-Fi mode on {usb_serial}...")
            subprocess.call(["adb", "-s", usb_serial, "tcpip", "5555"])
            time.sleep(1)
            phone_ip = get_phone_ip(usb_serial) or get_default_gateway()
            if try_connect_ip(phone_ip):
                target_device = (f"{phone_ip}:5555", devices[0][1])
                save_known_device(f"{phone_ip}:5555", devices[0][1], phone_ip)
                print("[✓] Wireless link active! You can now unplug your USB cable.")

    serial, model = target_device
    gpu = detect_hardware()

    # Save working device to persistent registry
    if ":" in serial:
        ip = serial.split(":")[0]
        save_last_ip(ip)
        save_known_device(serial, model, ip)

    print("==================================================")
    print("⚡ PhantomMirror - Ultra Low-Latency Suite")
    print("==================================================")
    print(f"[+] Target Device  : {model} ({serial})")
    print(f"[+] Connection     : {'WIRELESS (Hotspot/Wi-Fi)' if ':' in serial else 'USB HIGH-SPEED'}")
    print(f"[+] Detected Host  : {gpu.upper()} Graphics Architecture")
    print(f"[+] Active Profile : {profile.upper()}")

    # Wake up device if currently asleep/dozing and dismiss keyguard
    try:
        subprocess.run(["adb", "-s", serial, "shell", "svc power stayon true"], timeout=1, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["adb", "-s", serial, "shell", "input keyevent KEYCODE_WAKEUP"], timeout=1, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["adb", "-s", serial, "shell", "wm dismiss-keyguard"], timeout=1, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    # Base high-performance arguments
    args = [
        "/snap/bin/scrcpy",
        "-s", serial,
        "--stay-awake",
    ]

    # Virtual Session mode (Apple iPhone Mirroring-style independent secondary display on Android 14+)
    if virtual_display:
        args.extend([
            "--new-display=1080x2354/420",
            "-x",
            "--no-vd-destroy-content",
        ])
        if app:
            target_app = app if app.startswith(('?', '+')) else f"?{app}"
            args.append(f"--start-app={target_app}")
            print(f"[+] Virtual Session: Launching app '{app}' on independent display")
        else:
            args.append("--start-app=com.android.settings")
            print("[+] Virtual Session: Launching System Hub on independent display")
        print("[+] Virtual Session Mode: ACTIVE (Independent screen that stays active when phone is locked/closed)")
        print("[*] Window is dynamically resizable (-x flex display enabled)")

    # Hardware & Performance Profiles
    if profile == "pro":
        # Apple-grade 120 FPS / H.265 / 24 Mbps (Ideal for RTX 3050 & high-end screens)
        args.extend([
            "--video-codec=h265",
            "--video-bit-rate=24M",
            "--max-fps=120",
        ])
        print("[*] Preset: 120 FPS • H.265 (HEVC) • 24 Mbps [Pro]")

    elif profile == "battery":
        # Ultra-lightweight 720p / H.264 / 6 Mbps (Ideal for battery conservation & legacy iGPUs)
        args.extend([
            "--video-codec=h264",
            "--video-bit-rate=6M",
            "--max-size=1280",
            "--max-fps=60",
        ])
        print("[*] Preset: 60 FPS • H.264 • 6 Mbps [Battery / Low-Spec]")

    else:
        # Balanced default: 60 FPS / H.265 / 12 Mbps (Ideal for Intel Iris Xe / AMD Radeon iGPUs)
        args.extend([
            "--video-codec=h265",
            "--video-bit-rate=12M",
            "--max-fps=60",
        ])
        print("[*] Preset: 60 FPS • H.265 (HEVC) • 12 Mbps [Balanced iGPU]")

    # Audio forwarding
    if audio:
        args.extend([
            "--audio-codec=opus",
            "--audio-bit-rate=128K",
        ])
    else:
        args.append("--no-audio")

    # Screen off mode: Enabled by default to keep physical screen dark like Apple Mirroring
    if screen_off and not virtual_display:
        args.append("--turn-screen-off")
        print("[+] Screen-Off Mode: Physical phone display is powered OFF to save battery")
        print("[!] Pro-Tip: You do NOT need to press your phone's physical power button.")
        print("             (If phone locks/dozes, Right-Click in the window or press Alt+P to wake it instantly)")

    env = os.environ.copy()
    if "DISPLAY" not in env:
        env["DISPLAY"] = ":0"

    # Apple-style Device Display Frame & Shape Engine
    if frame or pure_shape:
        try:
            from phantom_frame import get_device_display_profile, launch_with_apple_frame, launch_pure_shape
            profile_data = get_device_display_profile(serial)
            if pure_shape:
                launch_pure_shape(profile_data, args, scale_h=scale)
            else:
                launch_with_apple_frame(profile_data, args, scale_h=scale)
            return
        except Exception as e:
            print(f"[!] Apple Frame notice: {e}. Falling back to standard viewport.")

    print("\n[+] Launching PhantomMirror viewport...")
    try:
        subprocess.run(args, env=env)
    except KeyboardInterrupt:
        print("\n[*] PhantomMirror closed.")

def main():
    # 1. Quick diagnostics command
    if len(sys.argv) > 1 and sys.argv[1] in ("doctor", "--doctor"):
        run_doctor()
        return

    # 2. Version check
    if len(sys.argv) > 1 and sys.argv[1] in ("-v", "--version"):
        print(f"⚡ PhantomMirror v{VERSION} (Production Suite)")
        return

    # 3. Open GUI Hub if explicitly requested or launched from desktop application launcher (non-TTY)
    if "--gui" in sys.argv or (len(sys.argv) == 1 and os.environ.get("DISPLAY") and not sys.stdin.isatty()):
        open_quick_hub()
        return

    parser = argparse.ArgumentParser(description="PhantomMirror Launcher")
    parser.add_argument(
        "-v", "--version",
        action="version",
        version=f"⚡ PhantomMirror v{VERSION}",
    )
    parser.add_argument(
        "--gui",
        action="store_true",
        help="Open PhantomMirror Desktop Control Hub",
    )
    parser.add_argument(
        "--profile",
        choices=["pro", "balanced", "battery"],
        default="pro",
        help="Performance profile: 'pro' (120 FPS / H.265), 'balanced' (60 FPS / iGPU), 'battery' (H.264 / 720p)",
    )
    parser.add_argument(
        "--wireless",
        action="store_true",
        help="Enable Wi-Fi / Mobile Hotspot mode",
    )
    parser.add_argument(
        "--ip",
        type=str,
        default=None,
        help="Manually specify phone IP address (e.g., --ip 192.168.43.1 or --ip 10.110.202.49)",
    )
    parser.add_argument(
        "--keep-screen-on",
        action="store_true",
        help="Keep the physical phone display turned ON (by default it turns off for battery/privacy)",
    )
    parser.add_argument(
        "--virtual-session", "--virtual-display",
        dest="virtual_display",
        action="store_true",
        help="Apple iPhone Mirroring style independent virtual session (stays alive even when phone is locked/closed)",
    )
    parser.add_argument(
        "--app", "--start-app",
        dest="app",
        type=str,
        default=None,
        help="App package or prefix to open in Virtual Session (e.g., --app whatsapp, --app spotify, --app settings)",
    )
    parser.add_argument(
        "--no-audio",
        action="store_true",
        help="Disable audio streaming",
    )
    parser.add_argument(
        "--audio",
        action="store_true",
        default=False,
        help="Force enable audio streaming (for Virtual Session mode)",
    )
    parser.add_argument(
        "--no-frame",
        dest="frame",
        action="store_false",
        default=True,
        help="Disable Apple device frame and launch standard raw viewport",
    )
    parser.add_argument(
        "--pure-shape",
        action="store_true",
        help="Apply device display corner curvature directly to the screen without outer chassis bezel",
    )
    parser.add_argument(
        "--scale",
        type=int,
        default=None,
        help="Custom height in pixels for the mirrored viewport (default: auto-fit based on desktop display)",
    )

    args = parser.parse_args()
    audio_enabled = args.audio if args.virtual_display else (not args.no_audio)

    launch_mirror(
        profile=args.profile,
        wireless=args.wireless,
        custom_ip=args.ip,
        screen_off=not args.keep_screen_on,
        virtual_display=args.virtual_display,
        app=args.app,
        audio=audio_enabled,
        frame=args.frame,
        pure_shape=args.pure_shape,
        scale=args.scale,
    )

if __name__ == "__main__":
    main()
