def get_adb_binary():
    """Locate adb binary across Windows, Linux, and custom installations."""
    if "ADB_PATH" in os.environ and os.path.isfile(os.environ["ADB_PATH"]):
        return os.environ["ADB_PATH"]
    found = shutil.which("adb")
    if found:
        return found
    if sys.platform == "win32":
        candidates = [
            os.path.expandvars(r"%LOCALAPPDATA%\Android\Sdk\platform-tools\adb.exe"),
            os.path.expandvars(r"%USERPROFILE%\scoop\shims\adb.exe"),
            r"C:\ProgramData\chocolatey\bin\adb.exe",
            r"C:\scrcpy\adb.exe",
            os.path.expandvars(r"%ProgramFiles%\Android\platform-tools\adb.exe"),
        ]
        for c in candidates:
            if os.path.isfile(c):
                return c
    return "adb"


def get_scrcpy_binary():
    """Locate scrcpy binary across Windows, Linux, and custom installations."""
    if "SCRCPY_PATH" in os.environ and os.path.isfile(os.environ["SCRCPY_PATH"]):
        return os.environ["SCRCPY_PATH"]
    found = shutil.which("scrcpy")
    if found:
        return found
    if sys.platform == "win32":
        candidates = [
            r"C:\scrcpy\scrcpy.exe",
            r"C:\ProgramData\chocolatey\bin\scrcpy.exe",
            os.path.expandvars(r"%LOCALAPPDATA%\Microsoft\WinGet\Packages\Genymobile.scrcpy_Microsoft.Winget.Source_8wekyb3d8bbwe\scrcpy.exe"),
            os.path.expandvars(r"%USERPROFILE%\scoop\shims\scrcpy.exe"),
            os.path.expandvars(r"%ProgramFiles%\scrcpy\scrcpy.exe"),
        ]
        winget_pkg = os.path.expandvars(r"%LOCALAPPDATA%\Microsoft\WinGet\Packages")
        if os.path.isdir(winget_pkg):
            try:
                for root, dirs, files in os.walk(winget_pkg):
                    if "scrcpy.exe" in files:
                        candidates.append(os.path.join(root, "scrcpy.exe"))
            except Exception:
                pass
        for c in candidates:
            if os.path.isfile(c):
                return c
    elif os.path.exists("/snap/bin/scrcpy"):
        return "/snap/bin/scrcpy"
    return "scrcpy"


def detect_hardware():
    """Detect GPU vendor (NVIDIA / Intel / AMD) to select optimal decoder."""
    if sys.platform == "win32":
        try:
            out = subprocess.check_output(
                ["powershell", "-NoProfile", "-Command", "Get-CimInstance Win32_VideoController | Select-Object -ExpandProperty Name"],
                text=True, timeout=3, stderr=subprocess.DEVNULL
            ).lower()
            if "nvidia" in out or "geforce" in out or "rtx" in out or "gtx" in out:
                return "nvidia"
            elif "intel" in out or "iris" in out or "arc" in out:
                return "intel"
            elif "amd" in out or "radeon" in out:
                return "amd"
        except Exception:
            pass
        try:
            out = subprocess.check_output(["wmic", "path", "win32_VideoController", "get", "name"], text=True, timeout=2).lower()
            if "nvidia" in out:
                return "nvidia"
            elif "intel" in out:
                return "intel"
            elif "amd" in out or "radeon" in out:
                return "amd"
        except Exception:
            pass
        return "integrated"
    else:
        try:
            lspci = subprocess.check_output(["lspci"], text=True).lower()
            if "nvidia" in lspci:
                return "nvidia"
            elif "intel" in lspci:
                return "intel"
            elif "amd" in lspci or "radeon" in lspci:
                return "amd"
        except Exception:
            pass
        return "integrated"


