#!/usr/bin/env bash
"""":
# Wrapper to execute with python3
exec python3 "$0" "$@"
"""
import subprocess
import sys
import os
import argparse
import time

LAST_IP_FILE = os.path.expanduser("~/.phantom_last_ip")

def save_last_ip(ip):
    try:
        with open(LAST_IP_FILE, "w") as f:
            f.write(ip.strip())
    except Exception:
        pass

def load_last_ip():
    try:
        if os.path.exists(LAST_IP_FILE):
            with open(LAST_IP_FILE, "r") as f:
                ip = f.read().strip()
                if ip:
                    return ip
    except Exception:
        pass
    return None

def get_default_gateway():
    """Find the Wi-Fi / Hotspot gateway IP address automatically."""
    try:
        out = subprocess.check_output(["ip", "route"], text=True)
        for line in out.splitlines():
            if line.startswith("default via"):
                parts = line.split()
                if len(parts) >= 3:
                    return parts[2]
    except Exception:
        pass
    return "192.168.43.1"

def try_connect_ip(ip, port=5555):
    """Attempt connecting to a specific IP on port 5555."""
    clean_ip = ip.split(":")[0].strip()
    if not clean_ip:
        return False
    target = f"{clean_ip}:{port}"
    print(f"[*] Trying wireless connection to {target}...")
    try:
        out = subprocess.check_output(["adb", "connect", target], text=True, timeout=5)
        if "connected to" in out.lower() or "already connected" in out.lower():
            print(f"[+] Successfully connected to {target}")
            save_last_ip(clean_ip)
            return True
    except Exception:
        pass
    return False

def get_connected_devices():
    try:
        out = subprocess.check_output(["adb", "devices", "-l"], text=True)
        lines = [line.strip() for line in out.strip().split("\n")[1:] if line.strip()]
        devices = []
        for line in lines:
            parts = line.split()
            if len(parts) >= 2 and parts[1] == "device":
                serial = parts[0]
                model = "Android Device"
                for p in parts[2:]:
                    if p.startswith("model:"):
                        model = p.split(":")[1]
                devices.append((serial, model))
        return devices
    except Exception as e:
        print(f"[-] ADB query error: {e}")
        return []

def detect_hardware():
    """Detect GPU vendor (NVIDIA / Intel / AMD) to select optimal decoder."""
    try:
        lspci = subprocess.check_output(["lspci"], text=True).lower()
        if "nvidia" in lspci:
            return "nvidia"
        elif "intel" in lspci:
            return "intel"
        elif "amd" in lspci or "radeon" in lspci:
            return "amd"
    except Exception:
        pass
    return "integrated"

def get_phone_ip(serial=None):
    cmd = ["adb"]
    if serial:
        cmd.extend(["-s", serial])
    cmd.extend(["shell", "ip route | awk '{print $9}' | head -n 1"])
    try:
        ip = subprocess.check_output(cmd, text=True).strip()
        if ip and ip.count(".") == 3:
            return ip
    except Exception:
        pass
    return get_default_gateway()

def launch_mirror(profile="pro", wireless=False, custom_ip=None, screen_off=False, virtual_display=False, app=None, audio=True):
    # 1. If user supplied an explicit IP, connect to it directly
    if custom_ip:
        try_connect_ip(custom_ip)

    devices = get_connected_devices()

    # 2. If no devices connected, attempt smart wireless discovery
    if not devices:
        print("[!] No USB device detected. Scanning for wireless phone...")

        # Candidates to probe:
        # a) Last remembered working IP
        # b) Default gateway IP
        # c) Standard Android Hotspot fallback (192.168.43.1)
        candidates = []
        last_ip = load_last_ip()
        if last_ip:
            candidates.append(last_ip)
        gw = get_default_gateway()
        if gw and gw not in candidates:
            candidates.append(gw)
        if "192.168.43.1" not in candidates:
            candidates.append("192.168.43.1")

        for cand in candidates:
            if try_connect_ip(cand):
                devices = get_connected_devices()
                break

    # 3. If still no device, prompt the user for IP or USB
    if not devices:
        print("\n[-] Could not auto-detect your phone's wireless IP.")
        print("[*] To connect wirelessly:")
        print("    1. Plug in USB once and run: ./phantom --wireless (to auto-configure)")
        print("    2. Or enter your phone's Wi-Fi IP address directly below.")
        print("       (Find it on your phone in Settings -> Wi-Fi -> IP Address)")
        try:
            manual_ip = input("\n[?] Enter phone IP (or press Enter to cancel): ").strip()
            if manual_ip:
                if try_connect_ip(manual_ip):
                    devices = get_connected_devices()
        except (KeyboardInterrupt, EOFError):
            print("\nAborted.")
            sys.exit(1)

    if not devices:
        print("\n[-] No device connected. Please plug in USB or connect to Wi-Fi/Hotspot.")
        sys.exit(1)

    # Pick target device
    target_device = devices[0]

    # If wireless mode requested but connected via USB, enable TCP/IP and switch
    if wireless:
        wireless_devs = [d for d in devices if ":" in d[0]]
        if wireless_devs:
            target_device = wireless_devs[0]
        else:
            usb_serial = devices[0][0]
            print(f"[*] Enabling Wi-Fi mode on {usb_serial}...")
            subprocess.call(["adb", "-s", usb_serial, "tcpip", "5555"])
            time.sleep(1)
            phone_ip = get_phone_ip(usb_serial) or get_default_gateway()
            if try_connect_ip(phone_ip):
                target_device = (f"{phone_ip}:5555", devices[0][1])
                print("[✓] Wireless link active! You can now unplug your USB cable.")

    serial, model = target_device
    gpu = detect_hardware()

    # Save working IP if wireless
    if ":" in serial:
        save_last_ip(serial.split(":")[0])

    print("==================================================")
    print("⚡ PhantomMirror - Ultra Low-Latency Suite")
    print("==================================================")
    print(f"[+] Target Device  : {model} ({serial})")
    print(f"[+] Connection     : {'WIRELESS (Hotspot/Wi-Fi)' if ':' in serial else 'USB HIGH-SPEED'}")
    print(f"[+] Detected Host  : {gpu.upper()} Graphics Architecture")
    print(f"[+] Active Profile : {profile.upper()}")

    # Wake up device if currently asleep/dozing and dismiss keyguard
    try:
        subprocess.run(["adb", "-s", serial, "shell", "svc power stayon true"], timeout=1, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["adb", "-s", serial, "shell", "input keyevent KEYCODE_WAKEUP"], timeout=1, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["adb", "-s", serial, "shell", "wm dismiss-keyguard"], timeout=1, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    # Base high-performance arguments
    args = [
        "/snap/bin/scrcpy",
        "-s", serial,
        "--stay-awake",
    ]

    # Virtual Session mode (Apple iPhone Mirroring-style independent secondary display on Android 14+)
    if virtual_display:
        args.extend([
            "--new-display=1080x2354/420",
            "-x",
            "--no-vd-destroy-content",
        ])
        if app:
            target_app = app if app.startswith(('?', '+')) else f"?{app}"
            args.append(f"--start-app={target_app}")
            print(f"[+] Virtual Session: Launching app '{app}' on independent display")
        else:
            args.append("--start-app=com.android.settings")
            print("[+] Virtual Session: Launching System Hub on independent display")
        print("[+] Virtual Session Mode: ACTIVE (Independent screen that stays active when phone is locked/closed)")
        print("[*] Window is dynamically resizable (-x flex display enabled)")

    # Hardware & Performance Profiles
    if profile == "pro":
        # Apple-grade 120 FPS / H.265 / 24 Mbps (Ideal for RTX 3050 & high-end screens)
        args.extend([
            "--video-codec=h265",
            "--video-bit-rate=24M",
            "--max-fps=120",
        ])
        print("[*] Preset: 120 FPS • H.265 (HEVC) • 24 Mbps [Pro]")

    elif profile == "battery":
        # Ultra-lightweight 720p / H.264 / 6 Mbps (Ideal for battery conservation & legacy iGPUs)
        args.extend([
            "--video-codec=h264",
            "--video-bit-rate=6M",
            "--max-size=1280",
            "--max-fps=60",
        ])
        print("[*] Preset: 60 FPS • H.264 • 6 Mbps [Battery / Low-Spec]")

    else:
        # Balanced default: 60 FPS / H.265 / 12 Mbps (Ideal for Intel Iris Xe / AMD Radeon iGPUs)
        args.extend([
            "--video-codec=h265",
            "--video-bit-rate=12M",
            "--max-fps=60",
        ])
        print("[*] Preset: 60 FPS • H.265 (HEVC) • 12 Mbps [Balanced iGPU]")

    # Audio forwarding
    if audio:
        args.extend([
            "--audio-codec=opus",
            "--audio-bit-rate=128K",
        ])
    else:
        args.append("--no-audio")

    # Screen off mode: Enabled by default to keep physical screen dark like Apple Mirroring
    if screen_off and not virtual_display:
        args.append("--turn-screen-off")
        print("[+] Screen-Off Mode: Physical phone display is powered OFF to save battery")
        print("[!] Pro-Tip: You do NOT need to press your phone's physical power button.")
        print("             (If phone locks/dozes, Right-Click in the window or press Alt+P to wake it instantly)")

    env = os.environ.copy()
    if "DISPLAY" not in env:
        env["DISPLAY"] = ":0"

    print("\n[+] Launching PhantomMirror viewport...")
    try:
        subprocess.run(args, env=env)
    except KeyboardInterrupt:
        print("\n[*] PhantomMirror closed.")

def main():
    parser = argparse.ArgumentParser(description="PhantomMirror Launcher")
    parser.add_argument(
        "--profile",
        choices=["pro", "balanced", "battery"],
        default="pro",
        help="Performance profile: 'pro' (120 FPS / H.265), 'balanced' (60 FPS / iGPU), 'battery' (H.264 / 720p)",
    )
    parser.add_argument(
        "--wireless",
        action="store_true",
        help="Enable Wi-Fi / Mobile Hotspot mode",
    )
    parser.add_argument(
        "--ip",
        type=str,
        default=None,
        help="Manually specify phone IP address (e.g., --ip 192.168.43.1 or --ip 10.110.202.49)",
    )
    parser.add_argument(
        "--keep-screen-on",
        action="store_true",
        help="Keep the physical phone display turned ON (by default it turns off for battery/privacy)",
    )
    parser.add_argument(
        "--virtual-session", "--virtual-display",
        dest="virtual_display",
        action="store_true",
        help="Apple iPhone Mirroring style independent virtual session (stays alive even when phone is locked/closed)",
    )
    parser.add_argument(
        "--app", "--start-app",
        dest="app",
        type=str,
        default=None,
        help="App package or prefix to open in Virtual Session (e.g., --app whatsapp, --app spotify, --app settings)",
    )
    parser.add_argument(
        "--no-audio",
        action="store_true",
        help="Disable audio streaming",
    )
    parser.add_argument(
        "--audio",
        action="store_true",
        default=False,
        help="Force enable audio streaming (for Virtual Session mode)",
    )

    args = parser.parse_args()
    audio_enabled = args.audio if args.virtual_display else (not args.no_audio)

    launch_mirror(
        profile=args.profile,
        wireless=args.wireless,
        custom_ip=args.ip,
        screen_off=not args.keep_screen_on,
        virtual_display=args.virtual_display,
        app=args.app,
        audio=audio_enabled,
    )

if __name__ == "__main__":
    main()
