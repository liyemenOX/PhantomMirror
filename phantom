def run_doctor():
    """Production system and hardware diagnostic utility."""
    import shutil
    print("==================================================")
    print(f"🩺 PhantomMirror System & Hardware Diagnostics (v{VERSION})")
    print("==================================================")

    # 1. ADB
    adb_path = shutil.which("adb")
    if adb_path:
        try:
            ver = subprocess.check_output(["adb", "version"], text=True).splitlines()[0]
            print(f"[✓] ADB Found           : {adb_path} ({ver})")
        except Exception:
            print(f"[✓] ADB Found           : {adb_path}")
    else:
        print("[-] ADB Missing         : Not found in PATH (Install via: sudo apt install adb)")

    # 2. Scrcpy
    scrcpy_path = shutil.which("scrcpy") or ("/snap/bin/scrcpy" if os.path.exists("/snap/bin/scrcpy") else None)
    if scrcpy_path:
        try:
            ver = subprocess.check_output([scrcpy_path, "--version"], text=True).splitlines()[0]
            print(f"[✓] Scrcpy Engine       : {scrcpy_path} ({ver})")
        except Exception:
            print(f"[✓] Scrcpy Engine       : {scrcpy_path}")
    else:
        print("[-] Scrcpy Missing      : Not found in PATH or /snap/bin/scrcpy")

    # 3. GPU Architecture & VA-API
    gpu = detect_hardware()
    if gpu == "nvidia":
        gpu_desc = "NVIDIA Architecture (NVDEC / VA-API Interop Supported)"
    elif gpu == "intel":
        gpu_desc = "Intel Iris Xe / UHD Graphics (VA-API Supported)"
    elif gpu == "amd":
        gpu_desc = "AMD Radeon Graphics (VA-API Supported)"
    else:
        gpu_desc = "Integrated Graphics Engine"
    print(f"[✓] Hardware Decoding   : {gpu_desc}")

    # 4. Display Server & Shape Extension
    disp = os.environ.get("DISPLAY", ":0")
    session = os.environ.get("XDG_SESSION_TYPE", "x11")
    try:
        from Xlib import display as xdisp
        from Xlib.ext import shape
        d = xdisp.Display()
        has_shape = hasattr(shape, "mask")
        d.close()
        shape_status = "Supported" if has_shape else "Unavailable"
    except Exception:
        shape_status = "Unavailable"
    print(f"[✓] Display Server      : {session.upper()} ({disp}) • XShape: {shape_status}")

    # 5. Connected Devices
    try:
        out = subprocess.check_output(["adb", "devices", "-l"], text=True)
        lines = [l.strip() for l in out.splitlines()[1:] if l.strip()]
        devs = [l.split()[0] for l in lines if len(l.split()) >= 2 and l.split()[1] == "device"]
        if devs:
            print(f"[✓] Connected Devices   : {len(devs)} active ({', '.join(devs)})")
        else:
            print("[!] Connected Devices   : No device currently attached (Connect via USB or Wi-Fi)")
    except Exception as e:
        print(f"[-] Device Query Error  : {e}")

    # 6. Saved Registry Devices
    known = load_known_devices()
    if known:
        print(f"[✓] Known Saved Devices : {len(known)} remembered in persistent registry")
        for ser, data in known.items():
            if isinstance(data, dict):
                print(f"    • {data.get('model', 'Phone')} ({ser} - {data.get('ip', 'IP')})")

    print("==================================================")
    print("🎉 System is 100% READY for Ultra-Low Latency Mirroring!")
    print("==================================================")

